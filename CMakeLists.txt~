cmake_minimum_required(VERSION 3.16...3.27)
project(AntiprotonCalo)

find_package(Geant4 REQUIRED ui_all vis_all)
include(${Geant4_USE_FILE})

#Allow organization into src and inc 
include_directories(
	${PROJECT_SOURCE_DIR}/inc
	${PROJECT_SOURCE_DIR}/src
)

#grab contents of src and inc
file(GLOB all_SRC
	  "${PROJECT_SOURCE_DIR}/inc/*.hh"
	  "${PROJECT_SOURCE_DIR}/src/*.cc"
)



add_executable(sim ${all_SRCS})
target_link_libraries(sim ${Geant4_LIBRARIES})

# Copy macros next to the executable
foreach(m init_vis.mac vis.mac run.mac)
  configure_file(${PROJECT_SOURCE_DIR}/${m} ${PROJECT_BINARY_DIR}/${m} COPYONLY)
endforeach()
